@page "/tickets"
@using SupportTicketApp.Client.Models
@using SupportTicketApp.Client.Services
@inject ITicketApiService TicketApiService
@inject IJSRuntime JSRuntime

<PageTitle>Support Tickets</PageTitle>

<h1>Support Tickets</h1>

<div class="mb-3">
    <a class="btn btn-primary" href="/tickets/create">
        <i class="bi bi-plus-circle me-2"></i>
        Create Ticket
    </a>
</div>

@if (_isLoading)
{
    <p>Loading tickets...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Unable to load tickets.</strong>
        <div>@_errorMessage</div>
    </div>

    <button class="btn btn-primary" @onclick="LoadTicketsAsync">
        Try Again
    </button>
}
else if (_tickets.Count == 0)
{
    <div class="alert alert-info" role="alert">
        No tickets were found.
    </div>
}
else if (!string.IsNullOrWhiteSpace(_deleteErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_deleteErrorMessage
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Customer</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Technician</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (TicketDto ticket in _tickets)
            {
                <tr>
                    <td>@ticket.TicketId</td>
                    <td>@ticket.Title</td>
                    <td>@ticket.CompanyName</td>
                    <td>@ticket.Priority</td>
                    <td>@ticket.Status</td>
                    <td>@ticket.TechnicianName</td>
                    <td>
                        @ticket.CreatedAtUtc.ToLocalTime().ToString("g")
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary me-2"
                           href="@($"/tickets/details/{ticket.TicketId}")">
                            <i class="bi bi-eye me-1"></i>
                            Details
                        </a>
                        <a class="btn btn-sm btn-outline-primary me-2"
                           href="@($"/tickets/edit/{ticket.TicketId}")">
                            <i class="bi bi-pencil-square me-1"></i>
                            Edit
                        </a>

                        <button class="btn btn-sm btn-outline-danger"
                                disabled="@(_deletingTicketId == ticket.TicketId)"
                                @onclick="() => DeleteTicketAsync(ticket)">
                            <i class="bi bi-trash me-1"></i>

                            @(_deletingTicketId == ticket.TicketId
                                ? "Deleting..."
                                : "Delete")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TicketDto> _tickets = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private int? _deletingTicketId;
    private string? _deleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            _tickets = await TicketApiService.GetAllAsync();
        }
        catch (HttpRequestException exception)
        {
            _errorMessage =
                $"The API request failed: {exception.Message}";
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteTicketAsync(TicketDto ticket)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            $"Delete ticket {ticket.TicketId}: {ticket.Title}?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            _deletingTicketId = ticket.TicketId;
            _deleteErrorMessage = null;

            bool deleted =
                await TicketApiService.DeleteAsync(ticket.TicketId);

            if (!deleted)
            {
                _deleteErrorMessage =
                    $"Ticket {ticket.TicketId} was not found.";

                return;
            }

            _tickets.Remove(ticket);
        }
        catch (Exception exception)
        {
            _deleteErrorMessage = exception.Message;
        }
        finally
        {
            _deletingTicketId = null;
        }
    }
}