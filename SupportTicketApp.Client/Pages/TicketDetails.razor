@page "/tickets/details/{TicketId:int}"
@using SupportTicketApp.Client.Models
@using SupportTicketApp.Client.Services
@inject ITicketApiService TicketApiService

<PageTitle>Ticket Details</PageTitle>

@if (_isLoading)
{
    <p>Loading ticket...</p>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Unable to load the ticket.</strong>
        <div>@_errorMessage</div>
    </div>

    <a class="btn btn-secondary mt-3" href="/tickets">
        Back to Tickets
    </a>
}
else if (_ticket is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Ticket @TicketId</h1>

        <span class="@GetPriorityBadgeClass(_ticket.Priority)">
            @_ticket.Priority
        </span>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">@_ticket.Title</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Ticket ID</dt>
                <dd class="col-sm-9">@_ticket.TicketId</dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">@_ticket.CompanyName</dd>

                <dt class="col-sm-3">Contact</dt>
                <dd class="col-sm-9">@_ticket.ContactName</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge text-bg-info">
                        @_ticket.Status
                    </span>
                </dd>

                <dt class="col-sm-3">Technician</dt>
                <dd class="col-sm-9">
                    @_ticket.TechnicianName
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @_ticket.CreatedAtUtc
                    .ToLocalTime()
                    .ToString("f")
                </dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(
                        _ticket.Description))
                    {
                        <span class="text-muted">
                            No description provided.
                        </span>
                    }
                    else
                    {
                        <span class="text-break">
                            @_ticket.Description
                        </span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-primary"
           href="@($"/tickets/edit/{_ticket.TicketId}")">
            <i class="bi bi-pencil-square me-1"></i>
            Edit
        </a>

        <a class="btn btn-secondary ms-2" href="/tickets">
            Back to Tickets
        </a>
    </div>
}

@code {
    [Parameter]
    public int TicketId { get; set; }

    private TicketDto? _ticket;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;

            _ticket =
                await TicketApiService.GetByIdAsync(TicketId);

            if (_ticket is null)
            {
                _errorMessage =
                    $"Ticket {TicketId} was not found.";
            }
        }
        catch (Exception exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetPriorityBadgeClass(string priority)
    {
        return priority switch
        {
            "Critical" => "badge text-bg-danger",
            "High" => "badge text-bg-warning",
            "Medium" => "badge text-bg-primary",
            "Low" => "badge text-bg-secondary",
            _ => "badge text-bg-light"
        };
    }
}